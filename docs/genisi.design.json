  "visual_system": {
    "viewport": {
      "html_body_width": "100vw",
      "html_body_height": "100vh",
      "body_overflow": "hidden",
      "desktop_area_height": "calc(100vh - 48px)",
      "taskbar_height": "48px"
    },
    "typography": {
      "font_stack": [
        "Segoe UI Variable Display",
        "Segoe UI",
        "Plus Jakarta Sans",
        "-apple-system",
        "sans-serif"
