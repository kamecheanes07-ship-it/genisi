      "wallpaper_treatment": "landscape_photo_with_blue_hue_rotation_saturation_brightness_contrast_and_blue_white_gradient_overlay"
    },
    "materials": {
      "mica_panel": {
        "background": "linear-gradient(160deg, rgba(245,250,255,0.82) 0%, rgba(230,242,255,0.76) 100%)",
        "backdrop_blur": "32px",
        "saturation": "190%",
        "border": "1px solid rgba(255,255,255,0.72)",
        "shadow": "0 24px 60px rgba(0,35,90,0.18), 0 2px 12px rgba(0,0,0,0.05)"
      },
      "mica_window": {
        "background": "linear-gradient(135deg, rgba(228,240,255,0.82) 0%, rgba(244,249,255,0.88) 100%)",
        "backdrop_blur": "36px",
        "saturation": "200%",
        "border": "1px solid rgba(255,255,255,0.8)",
        "shadow": "0 28px 70px rgba(8,38,88,0.24), 0 4px 16px rgba(0,0,0,0.06)"
      },
      "taskbar_glass": {
        "background": "rgba(232,242,255,0.68)",
        "backdrop_blur": "28px",
        "saturation": "190%",
        "border_top": "1px solid rgba(255,255,255,0.68)"
      },
      "pill_glass": {
        "background": "rgba(255,255,255,0.76)",
        "border": "1px solid rgba(255,255,255,0.88)",
        "shadow": "0 2px 10px rgba(0,35,90,0.06)"
      },
      "dark_mode": "same material grammar with translucent navy surfaces and adapted text/borders",
      "accessibility_mode": "body contrast 1.12 and 2px blue app-window borders"
    },
    "motion": {
      "window_transition": "transform 0.22s cubic-bezier(0.16,1,0.3,1), opacity 0.18s ease, width/height/top/left 0.22s ease",
      "hidden_window": "opacity 0; scale 0.94; translateY(18px); pointer-events none",
      "wallpaper_transition": "filter/background-image 0.5s ease; transform 0.6s cubic-bezier(0.22,1,0.36,1)",
      "lockscreen_unlock": "translateY(-100%) and opacity fade over 450ms callback window"
    }
  },
