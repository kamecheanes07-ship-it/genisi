  "functional_limitations": [
    "The File Explorer uses in-memory VFS state, not the host filesystem.",
    "The PowerShell panel is a simulated command interface, not a real shell.",
    "Copilot uses a small keyword-based action router, not general AI or OS automation.",
    "Outlook compose is a UI simulation and does not transmit email.",
    "Windows settings, Store, and Office actions are concept UI unless code proves a backend integration.",
    "Edge is an iframe-based concept browser, not a complete browser engine implementation.",
    "Media Player uses Web Audio synthesis rather than proving external music streaming."
  ],
  "change_policy": {
    "design_source": "embedded_system_prompt",
    "default_output": "create or update the requested project artifact without requiring an external master file",
    "patch_style": "minimal, additive, and scoped",
    "must_preserve": [
      "existing app windows",
      "IDs and relevant function contracts",
      "Mica design language",
      "window geometry",
      "taskbar and overlays",
      "working interactions"
    ],
    "never": [
      "generic redesign",
      "remove existing windows to simplify",
      "invent APIs",
      "claim simulations are real OS integrations",
      "claim an external reference file was loaded"
    ]
  },
  "validation": [
    "follow the embedded Windows 12 System Prompt as the design specification; no external reference file is required",
    "check JavaScript syntax",
    "check duplicate IDs and unresolved element references",
    "trace changed handlers and function callers",
    "test changed interactions and window manager behavior",
    "inspect light and dark mode plus accessibility mode",
    "compare screenshots at identical viewport when visual fidelity is claimed",
    "provide complete output file when requested",
    "state exact tests performed and unverified areas"
  ],
  "prompt_integration": {
    "runtime_source": "app/windows12_prompt.py",
    "runtime_loaded_automatically": true,
    "external_html_required": false,
    "dataset_read_required": false,
    "user_attachment_required": false,
    "note": "This is an optional design manifest for documentation. The application activates Windows 12 from its embedded System Prompt and does not load this JSON at runtime."
  }
